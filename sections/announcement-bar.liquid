{%- style -%}
  .announcement-bar {
    background-color: #5C6E61;
    color: #FFFFFF;
    padding: 10px 20px;
    text-align: center;
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    letter-spacing: 0.5px;
    position: relative;
    overflow: hidden;
  }

  .announcement-bar__slider {
    display: flex;
    transition: transform 0.5s ease-in-out;
  }

  .announcement-bar__slide {
    min-width: 100%;
    padding: 5px 0;
  }

  .announcement-bar__slide a {
    color: #FFFFFF;
    text-decoration: none;
    font-weight: 500;
  }

  .announcement-bar__slide a:hover {
    text-decoration: underline;
  }
{%- endstyle -%}

<div class="announcement-bar" data-section-id="{{ section.id }}">
  <div class="announcement-bar__slider">
    {%- for block in section.blocks -%}
      <div class="announcement-bar__slide" {{ block.shopify_attributes }}>
        {{ block.settings.text }}
      </div>
    {%- endfor -%}
  </div>
</div>

<script>
  (function() {
    const slider = document.querySelector('.announcement-bar__slider');
    if (!slider || slider.children.length <= 1) return;

    let currentSlide = 0;
    const slides = slider.children;
    const totalSlides = slides.length;

    setInterval(() => {
      currentSlide = (currentSlide + 1) % totalSlides;
      slider.style.transform = `translateX(-${currentSlide * 100}%)`;
    }, 4000);
  })();
</script>

{% schema %}
{
  "name": "Announcement Bar",
  "settings": [],
  "blocks": [
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "FREE SHIPPING on all orders over $49"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Announcement Bar",
      "blocks": [
        {
          "type": "text",
          "settings": {
            "text": "TRY A $2 SAMPLE!"
          }
        },
        {
          "type": "text",
          "settings": {
            "text": "FREE SHIPPING on all orders over $49 shipped within the US"
          }
        }
      ]
    }
  ]
}
{% endschema %}
