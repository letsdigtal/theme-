{%- style -%}
  .announcement-bar {
    background: var(--color-primary);
    color: #ffffff;
    text-align: center;
    padding: 0.75rem 1rem;
    font-size: 0.875rem;
    letter-spacing: 0.5px;
    position: relative;
    z-index: 1001;
  }

  .announcement-bar__text {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
  }

  .announcement-bar__link {
    color: inherit;
    text-decoration: none;
    font-weight: 500;
    transition: opacity 0.3s ease;
  }

  .announcement-bar__link:hover {
    opacity: 0.8;
    text-decoration: underline;
  }

  @media screen and (max-width: 768px) {
    .announcement-bar {
      padding: 0.5rem 1rem;
      font-size: 0.75rem;
    }
  }
{%- endstyle -%}

<div class="announcement-bar" role="banner">
  <div class="announcement-bar__text">
    {% if section.settings.announcement_link != blank %}
      <a href="{{ section.settings.announcement_link }}" class="announcement-bar__link">
        {{ section.settings.announcement_text }}
      </a>
    {% else %}
      <span>{{ section.settings.announcement_text }}</span>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Announcement Bar",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "announcement_text",
      "label": "Announcement Text",
      "default": "Free shipping on orders over $50 | Use code GLOW20 for 20% off"
    },
    {
      "type": "url",
      "id": "announcement_link",
      "label": "Announcement Link (optional)"
    }
  ],
  "presets": [
    {
      "name": "Announcement Bar"
    }
  ]
}
{% endschema %}
