{% comment %}
  Main 404 Section
{% endcomment %}

<section class="page-404 section-padding">
  <div class="page-container text-center">
    <h1 class="error-code">404</h1>
    <h2 class="error-title">{{ 'templates.404.title' | t }}</h2>
    <p class="error-message">{{ 'templates.404.subtext' | t }}</p>
    <a href="/" class="btn btn-primary">{{ 'templates.404.button' | t }}</a>
  </div>
</section>

<style>
  .page-404 {
    min-height: 60vh;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  .error-code {
    font-size: 8rem;
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: 1rem;
    line-height: 1;
  }
  
  .error-title {
    font-size: 2rem;
    margin-bottom: 1rem;
    color: var(--color-text);
  }
  
  .error-message {
    font-size: 1.125rem;
    color: var(--color-body-text);
    margin-bottom: 2rem;
    max-width: 500px;
    margin-left: auto;
    margin-right: auto;
  }
  
  @media (max-width: 768px) {
    .error-code {
      font-size: 5rem;
    }
    
    .error-title {
      font-size: 1.5rem;
    }
  }
</style>

{% schema %}
{
  "name": "404 Page",
  "settings": []
}
{% endschema %}
