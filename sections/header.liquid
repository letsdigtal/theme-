{% comment %}
  Header Section - LivSo Style
  Sticky header with logo, navigation, and cart icon
{% endcomment %}

<nav class="main-nav navbar" id="main-nav" role="navigation">
  <div class="navbar-inner">
    <div class="navbar-header">
      <button type="button" class="navbar-toggle collapsed" data-toggle="collapse" data-target="#navbar" aria-expanded="false">
        <span></span>
        <span></span>
        <span></span>
      </button>
      
      <a class="navbar-brand site-header__logo-link" href="/">
        {% if section.settings.logo != blank %}
          <img src="{{ section.settings.logo | image_url: width: 300 }}" alt="{{ shop.name }}" />
