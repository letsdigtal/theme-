          </svg>
        {% endif %}
      </a>
    </div>

    <div id="navbar" class="collapse navbar-collapse top" nav-collapse="">
      <nav role="navigation">
        <div class="nav-wrap outter">
          <div class="nav-wrap inner">
            <ul class="menu nav navbar-nav">
              {% for link in section.settings.menu.links %}
                <li>
                  <a href="{{ link.url }}">{{ link.title }}</a>
                  {% if link.links != blank %}
                    <div class="dropdown">
                      {% for child_link in link.links %}
                        <a href="{{ child_link.url }}">{{ child_link.title }}</a>
                      {% endfor %}
                    </div>
                  {% endif %}
                </li>
              {% endfor %}
              
              <li><div class="dash"><span></span></div></li>
              
              <li>
                <a href="/cart">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 20">
                    <circle fill="#FFFFFF" cx="7" cy="18" r="2"/>
                    <circle fill="#FFFFFF" cx="17" cy="18" r="2"/>
                    <path fill="#FFFFFF" d="M21.38,6l-1.91,7H6V6H21.38M6,0H0V2H2A2,2,0,0,1,4,4V15H21L24,4H6V0Z"/>
                  </svg>
                </a>
              </li>
            </ul>
          </div>
        </div>
      </nav>
    </div>
  </div>
</nav>

<div class="banner banner-first">
  <a href="/collections/all">
    <span>{{ section.settings.banner_text }}</span>
  </a>
</div>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    },
    {
      "type": "text",
      "id": "banner_text",
      "label": "Banner Text",
      "default": "FREE SHIPPING on all orders over $49 shipped within the US"
    }
  ]
}
{% endschema %}
