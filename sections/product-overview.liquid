{% comment %}
  Product Overview Section - LivSo Style
  3-column product slider with tabs
{% endcomment %}

<section class="product-overview">
  <div class="product-slides">
    <div class="container slider">
      {% for block in section.blocks %}
        <div class="product-tab">
          <div class="btn-wrap">
            <a href="{{ block.settings.product_link }}" class="cta">
              Shop<br> Now<span></span>
              <svg xmlns="http://www.w3.org/2000/svg" fill="#756e6a" viewBox="0 0 29.36 11.73">
                <rect y="5.36" width="29" height="1"/>
                <polyline points="28.66 5.36 23 11.02 23.71 11.73 29.36 6.07 29.36 5.66 23.71 0 23 0.71 28.66 6.36"/>
              </svg>
            </a>
          </div>
          
          {% if block.settings.product_image != blank %}
            <img src="{{ block.settings.product_image | image_url: width: 800 }}" alt="{{ block.settings.product_title }}" data-rjs="{{ block.settings.product_image | image_url: width: 1600 }}">
          {% endif %}
          
          <h1>{{ block.settings.product_title }}</h1>
          <p>{{ block.settings.product_description }}</p>
        </div>
      {% endfor %}
    </div>
    
    <div class="wave-wrap">
      <svg viewBox="0 0 1200 120" preserveAspectRatio="none">
        <path d="M0,0V46.29c47.79,22.2,103.59,32.17,158,28,70.36-5.37,136.33-33.31,206.8-37.5C438.64,32.43,512.34,53.67,583,72.05c69.27,18,138.3,24.88,209.4,13.08,36.15-6,69.85-17.84,104.45-29.34C989.49,25,1113-14.29,1200,52.47V0Z" opacity=".23"/>
        <path d="M0,0V15.81C13,36.92,27.64,56.86,47.69,72.05,99.41,111.27,165,111,224.58,91.58c31.15-10.15,60.09-26.07,89.67-39.8,40.92-19,84.73-46,130.83-49.67,36.26-2.85,70.9,9.42,98.6,31.56,31.77,25.39,62.32,62,103.63,73,40.44,10.79,81.35-6.69,119.13-24.28s75.16-39,116.92-43.05c59.73-5.85,113.28,22.88,168.9,38.84,30.2,8.66,59,6.17,87.09-7.5,22.43-10.89,48-26.93,60.65-49.24V0Z" opacity=".5"/>
        <path d="M0,0V5.63C149.93,59,314.09,66.42,475.08,42.83c43-6.34,81.54-25.96,127.67-29.58,38.89-3.05,73.05,15.71,104.32,37,27.59,18.78,63.15,31.33,96.78,28.54,34.74-2.88,62.33-27.05,91.65-39.67,33.12-14.32,70.18-19.84,104.92-11.16,34.72,8.67,60.73,35.17,85.82,56.63C1146.48,98.55,1172,111.63,1200,96.81V0Z"/>
      </svg>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product Overview",
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "image_picker",
          "id": "product_image",
          "label": "Product Image"
        },
        {
          "type": "text",
          "id": "product_title",
          "label": "Product Title",
          "default": "Moisturizing Shampoo"
        },
        {
          "type": "richtext",
          "id": "product_description",
          "label": "Product Description"
        },
        {
          "type": "url",
          "id": "product_link",
          "label": "Product Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Overview",
      "blocks": [
        { "type": "product" },
        { "type": "product" },
        { "type": "product" }
      ]
    }
  ]
}
{% endschema %}
