{%- style -%}
  .testimonials {
    padding: var(--spacing-xl) 2rem;
    background: #ffffff;
  }

  .testimonials__container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .testimonials__header {
    text-align: center;
    margin-bottom: 4rem;
  }

  .testimonials__subtitle {
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 3px;
    color: var(--color-primary);
    text-transform: uppercase;
    margin-bottom: 1rem;
  }

  .testimonials__title {
    font-family: var(--font-heading);
    font-size: 2.5rem;
    font-weight: 400;
    letter-spacing: 1px;
    color: var(--color-text);
  }

  .testimonials__slider {
    position: relative;
    overflow: hidden;
  }

  .testimonials__track {
    display: flex;
    transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .testimonials__slide {
    min-width: 100%;
    padding: 2rem;
  }

  .testimonials__content {
    max-width: 800px;
    margin: 0 auto;
    text-align: center;
  }

  .testimonials__rating {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.25rem;
    margin-bottom: 2rem;
  }

  .testimonials__star {
    width: 20px;
    height: 20px;
    color: #d4a574;
  }

  .testimonials__quote {
    font-family: var(--font-body);
    font-size: 1.5rem;
    line-height: 1.8;
    color: var(--color-text);
    font-style: italic;
    margin-bottom: 2.5rem;
    position: relative;
  }

  .testimonials__quote::before {
    content: '"';
    font-family: Georgia, serif;
    font-size: 4rem;
    color: var(--color-primary);
    opacity: 0.3;
    position: absolute;
    top: -2rem;
    left: 50%;
    transform: translateX(-50%);
  }

  .testimonials__author {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
  }

  .testimonials__author-image {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    object-fit: cover;
  }

  .testimonials__author-info {
    text-align: left;
  }

  .testimonials__author-name {
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.5px;
    color: var(--color-text);
    margin-bottom: 0.25rem;
  }

  .testimonials__author-location {
    font-family: var(--font-body);
    font-size: 0.875rem;
    color: #888;
  }

  .testimonials__controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 2rem;
    margin-top: 3rem;
  }

  .testimonials__nav-btn {
    background: none;
    border: 1px solid #e0e0e0;
    cursor: pointer;
    padding: 1rem;
    border-radius: 50%;
    transition: var(--transition-base);
    color: var(--color-text);
  }

  .testimonials__nav-btn:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
    transform: scale(1.1);
  }

  .testimonials__nav-btn svg {
    width: 20px;
    height: 20px;
  }

  .testimonials__dots {
    display: flex;
    gap: 0.75rem;
  }

  .testimonials__dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #e0e0e0;
    border: none;
    cursor: pointer;
    transition: var(--transition-base);
  }

  .testimonials__dot.is-active {
    background: var(--color-primary);
    transform: scale(1.3);
  }

  @media screen and (max-width: 768px) {
    .testimonials {
      padding: var(--spacing-lg) 1.5rem;
    }

    .testimonials__title {
      font-size: 2rem;
    }

    .testimonials__quote {
      font-size: 1.25rem;
    }

    .testimonials__author {
      flex-direction: column;
    }

    .testimonials__author-info {
      text-align: center;
    }
  }
{%- endstyle -%}

<section class="testimonials" data-section-id="{{ section.id }}">
  <div class="testimonials__container">
    {% if section.settings.section_title != blank %}
      <div class="testimonials__header">
        {% if section.settings.section_subtitle != blank %}
          <p class="testimonials__subtitle">{{ section.settings.section_subtitle }}</p>
        {% endif %}
        <h2 class="testimonials__title">{{ section.settings.section_title }}</h2>
      </div>
    {% endif %}

    <div class="testimonials__slider">
      <div class="testimonials__track">
        {% for block in section.blocks %}
          <div class="testimonials__slide" {{ block.shopify_attributes }}>
            <div class="testimonials__content">
              <div class="testimonials__rating">
                {% assign rating = block.settings.rating | default: 5 %}
                {% for i in (1..5) %}
                  <svg class="testimonials__star" viewBox="0 0 24 24" fill="{% if i <= rating %}currentColor{% else %}#e0e0e0{% endif %}">
                    <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                  </svg>
                {% endfor %}
              </div>

              {% if block.settings.quote != blank %}
                <p class="testimonials__quote">{{ block.settings.quote }}</p>
              {% endif %}

              <div class="testimonials__author">
                {% if block.settings.author_image != blank %}
                  <img 
                    src="{{ block.settings.author_image | image_url: width: 120 }}"
                    alt="{{ block.settings.author_name | default: 'Customer' }}"
                    class="testimonials__author-image"
                    width="60"
                    height="60"
                    loading="lazy"
                  >
                {% else %}
                  <div class="testimonials__author-image" style="background: #f0f0f0; display: flex; align-items: center; justify-content: center;">
                    <svg width="30" height="30" viewBox="0 0 24 24" fill="#ccc">
                      <circle cx="12" cy="8" r="4"/>
                      <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                    </svg>
                  </div>
                {% endif %}

                <div class="testimonials__author-info">
                  {% if block.settings.author_name != blank %}
                    <p class="testimonials__author-name">{{ block.settings.author_name }}</p>
                  {% endif %}
                  {% if block.settings.author_location != blank %}
                    <p class="testimonials__author-location">{{ block.settings.author_location }}</p>
                  {% endif %}
                </div>
              </div>
            </div>
          </div>
        {% endfor %}
      </div>
    </div>

    {% if section.blocks.size > 1 %}
      <div class="testimonials__controls">
        <button class="testimonials__nav-btn testimonials__nav-btn--prev" aria-label="Previous testimonial">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="m15 18-6-6 6-6"/>
          </svg>
        </button>

        <div class="testimonials__dots" role="tablist">
          {% for block in section.blocks %}
            <button 
              class="testimonials__dot {% if forloop.first %}is-active{% endif %}"
              data-slide="{{ forloop.index0 }}"
              aria-label="Go to testimonial {{ forloop.index }}"
              role="tab"
            ></button>
          {% endfor %}
        </div>

        <button class="testimonials__nav-btn testimonials__nav-btn--next" aria-label="Next testimonial">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="m9 18 6-6-6-6"/>
          </svg>
        </button>
      </div>
    {% endif %}
  </div>
</section>

<script>
  (function() {
    const track = document.querySelector('.testimonials__track');
    const slides = document.querySelectorAll('.testimonials__slide');
    const dots = document.querySelectorAll('.testimonials__dot');
    const prevBtn = document.querySelector('.testimonials__nav-btn--prev');
    const nextBtn = document.querySelector('.testimonials__nav-btn--next');
    
    let currentSlide = 0;

    function goToSlide(index) {
      track.style.transform = `translateX(-${index * 100}%)`;
      
      dots.forEach((dot, i) => {
        dot.classList.toggle('is-active', i === index);
      });
      
      currentSlide = index;
    }

    function nextSlide() {
      const nextIndex = (currentSlide + 1) % slides.length;
      goToSlide(nextIndex);
    }

    function prevSlide() {
      const prevIndex = (currentSlide - 1 + slides.length) % slides.length;
      goToSlide(prevIndex);
    }

    dots.forEach((dot, index) => {
      dot.addEventListener('click', () => goToSlide(index));
    });

    if (prevBtn) prevBtn.addEventListener('click', prevSlide);
    if (nextBtn) nextBtn.addEventListener('click', nextSlide);

    // Auto-rotate
    let autoPlayInterval;
    if ({{ section.settings.auto_rotate | default: true }}) {
      autoPlayInterval = setInterval(nextSlide, {{ section.settings.rotate_time | default: 5 }} * 1000);
      
      const slider = document.querySelector('.testimonials__slider');
      slider.addEventListener('mouseenter', () => clearInterval(autoPlayInterval));
      slider.addEventListener('mouseleave', () => {
        autoPlayInterval = setInterval(nextSlide, {{ section.settings.rotate_time | default: 5 }} * 1000);
      });
    }
  })();
</script>

{% schema %}
{
  "name": "Testimonials",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "section_subtitle",
      "label": "Subtitle",
      "default": "TESTIMONIALS"
    },
    {
      "type": "text",
      "id": "section_title",
      "label": "Title",
      "default": "What Our Customers Say"
    },
    {
      "type": "checkbox",
      "id": "auto_rotate",
      "label": "Auto rotate",
      "default": true
    },
    {
      "type": "range",
      "id": "rotate_time",
      "label": "Rotate time (seconds)",
      "min": 3,
      "max": 10,
      "step": 1,
      "default": 5
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "This product has completely transformed my skin! I've never felt more confident."
        },
        {
          "type": "text",
          "id": "author_name",
          "label": "Author Name",
          "default": "Sarah M."
        },
        {
          "type": "text",
          "id": "author_location",
          "label": "Location",
          "default": "Los Angeles, CA"
        },
        {
          "type": "image_picker",
          "id": "author_image",
          "label": "Author Image"
        },
        {
          "type": "range",
          "id": "rating",
          "label": "Rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [
        {
          "type": "testimonial"
        },
        {
          "type": "testimonial"
        },
        {
          "type": "testimonial"
        }
      ]
    }
  ]
}
{% endschema %}
