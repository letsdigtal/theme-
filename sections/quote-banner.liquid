{%- style -%}
  .quote-banner {
    padding: 80px 40px;
    background-color: #F4F7F4;
    text-align: center;
  }

  .quote-banner__text {
    font-family: 'Cormorant Garamond', serif;
    font-size: 36px;
    font-weight: 400;
    color: #2C302E;
    line-height: 1.6;
    margin-bottom: 24px;
    max-width: 900px;
    margin-left: auto;
    margin-right: auto;
  }

  .quote-banner__author {
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    color: #5C6E61;
    letter-spacing: 1px;
  }

  @media (max-width: 768px) {
    .quote-banner {
      padding: 60px 20px;
    }

    .quote-banner__text {
      font-size: 28px;
    }
  }
{%- endstyle -%}

<section class="quote-banner" data-section-id="{{ section.id }}">
  {%- if section.settings.text != blank -%}
    <h2 class="quote-banner__text">{{ section.settings.text }}</h2>
  {%- endif -%}

  {%- if section.settings.author != blank -%}
    <p class="quote-banner__author">{{ section.settings.author }}</p>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Quote Banner",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Quote Text",
      "default": ""I feel like LivSo helped me love my hair again.""
    },
    {
      "type": "text",
      "id": "author",
      "label": "Author",
      "default": "— Elizabeth Blount"
    }
  ],
  "presets": [
    {
      "name": "Quote Banner"
    }
  ]
}
{% endschema %}
