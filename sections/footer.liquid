{%- style -%}
  .footer {
    background-color: #FFFFFF;
    padding: 60px 40px 20px;
    border-top: 1px solid #E5E5E5;
  }

  .footer__container {
    max-width: 1400px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 60px;
    margin-bottom: 60px;
  }

  .footer__column h3 {
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: #2C302E;
    margin-bottom: 24px;
  }

  .footer__menu {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .footer__menu-item {
    margin-bottom: 12px;
  }

  .footer__menu-item a {
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    color: #2C302E;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    transition: opacity 0.3s ease;
  }

  .footer__menu-item a:hover {
    opacity: 0.7;
  }

  .footer__bottom {
    border-top: 1px solid #E5E5E5;
    padding-top: 20px;
    text-align: center;
  }

  .footer__copyright {
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    color: #5C6E61;
  }

  @media (max-width: 768px) {
    .footer {
      padding: 40px 20px 20px;
    }

    .footer__container {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }
{%- endstyle -%}

<footer class="footer" data-section-id="{{ section.id }}">
  <div class="footer__container">
    <div class="footer__column">
      <h3>{{ section.settings.products_title | default: 'Our Products' }}</h3>
      <ul class="footer__menu">
        {%- for link in section.settings.products_menu.links -%}
          <li class="footer__menu-item">
            <a href="{{ link.url }}">{{ link.title }}</a>
          </li>
        {%- endfor -%}
      </ul>
    </div>

    <div class="footer__column">
      <ul class="footer__menu">
        {%- for link in section.settings.links_menu.links -%}
          <li class="footer__menu-item">
            <a href="{{ link.url }}">{{ link.title }}</a>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </div>

  <div class="footer__bottom">
    <p class="footer__copyright">
      {{ section.settings.copyright_text | default: '© 2026 LivSo, LLC. All rights reserved.' }}
    </p>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "text",
      "id": "products_title",
      "label": "Products Title",
      "default": "Our Products"
    },
    {
      "type": "link_list",
      "id": "products_menu",
      "label": "Products Menu"
    },
    {
      "type": "link_list",
      "id": "links_menu",
      "label": "Links Menu"
    },
    {
      "type": "text",
      "id": "copyright_text",
      "label": "Copyright Text",
      "default": "© 2026 LivSo, LLC. All rights reserved."
    }
  ],
  "presets": [
    {
      "name": "Footer"
    }
  ]
}
{% endschema %}
