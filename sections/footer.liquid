{%- style -%}
  .footer {
    background: #1a1a1a;
    color: #ffffff;
    padding: var(--spacing-xl) 2rem var(--spacing-lg);
  }

  .footer__container {
    max-width: 1400px;
    margin: 0 auto;
  }

  .footer__grid {
    display: grid;
    grid-template-columns: 1.5fr repeat(3, 1fr);
    gap: 4rem;
    margin-bottom: 4rem;
  }

  .footer__brand {
    padding-right: 2rem;
  }

  .footer__logo {
    margin-bottom: 1.5rem;
  }

  .footer__logo img {
    max-height: 50px;
    width: auto;
  }

  .footer__logo-text {
    font-family: var(--font-heading);
    font-size: 1.75rem;
    font-weight: 600;
    letter-spacing: 2px;
    color: #ffffff;
    text-transform: uppercase;
  }

  .footer__description {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    line-height: 1.7;
    color: #999;
    margin-bottom: 1.5rem;
  }

  .footer__social {
    display: flex;
    gap: 1rem;
  }

  .footer__social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 50%;
    color: #ffffff;
    transition: var(--transition-base);
  }

  .footer__social-link:hover {
    border-color: var(--color-primary);
    background: var(--color-primary);
    transform: translateY(-3px);
  }

  .footer__social-link svg {
    width: 20px;
    height: 20px;
  }

  .footer__menu-title {
    font-family: var(--font-heading);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 1.5px;
    color: #ffffff;
    text-transform: uppercase;
    margin-bottom: 1.5rem;
  }

  .footer__menu-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .footer__menu-item a {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    color: #999;
    text-decoration: none;
    transition: var(--transition-base);
  }

  .footer__menu-item a:hover {
    color: #ffffff;
    padding-left: 5px;
  }

  .footer__bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding-top: 2rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .footer__copyright {
    font-family: var(--font-body);
    font-size: 0.875rem;
    color: #666;
  }

  .footer__payments {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .footer__payment-icon {
    width: 50px;
    height: 32px;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .footer__payment-icon svg {
    width: 30px;
    height: 20px;
    color: #ffffff;
  }

  @media screen and (max-width: 1024px) {
    .footer__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 3rem;
    }

    .footer__brand {
      grid-column: span 2;
      padding-right: 0;
    }
  }

  @media screen and (max-width: 768px) {
    .footer {
      padding: var(--spacing-lg) 1.5rem;
    }

    .footer__grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .footer__brand {
      grid-column: span 1;
    }

    .footer__bottom {
      flex-direction: column;
      text-align: center;
    }

    .footer__payments {
      flex-wrap: wrap;
      justify-content: center;
    }
  }
{%- endstyle -%}

<footer class="footer" role="contentinfo">
  <div class="footer__container">
    <div class="footer__grid">
      <!-- Brand Column -->
      <div class="footer__brand">
        {% if section.settings.footer_logo != blank %}
          <div class="footer__logo">
            <img src="{{ section.settings.footer_logo | image_url: width: 300 }}" alt="{{ shop.name }}">
          </div>
        {% else %}
          <div class="footer__logo-text">{{ shop.name }}</div>
        {% endif %}

        {% if section.settings.footer_description != blank %}
          <p class="footer__description">{{ section.settings.footer_description }}</p>
        {% endif %}

        {% if section.settings.show_social %}
          <div class="footer__social">
            {% if section.settings.social_facebook != blank %}
              <a href="{{ section.settings.social_facebook }}" class="footer__social-link" aria-label="Facebook" target="_blank" rel="noopener">
                <svg viewBox="0 0 24 24" fill="currentColor">
                  <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
                </svg>
              </a>
            {% endif %}
            
            {% if section.settings.social_instagram != blank %}
              <a href="{{ section.settings.social_instagram }}" class="footer__social-link" aria-label="Instagram" target="_blank" rel="noopener">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
                  <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
                  <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
                </svg>
              </a>
            {% endif %}
            
            {% if section.settings.social_twitter != blank %}
              <a href="{{ section.settings.social_twitter }}" class="footer__social-link" aria-label="Twitter" target="_blank" rel="noopener">
                <svg viewBox="0 0 24 24" fill="currentColor">
                  <path d="M23 3a10.9 10.9 0 0 1-3.14 1.53 4.48 4.48 0 0 0-7.86 3v1A10.66 10.66 0 0 1 3 4s-4 9 5 13a11.64 11.64 0 0 1-7 2c9 5 20 0 20-11.5a4.5 4.5 0 0 0-.08-.83A7.72 7.72 0 0 0 23 3z"/>
                </svg>
              </a>
            {% endif %}
            
            {% if section.settings.social_pinterest != blank %}
              <a href="{{ section.settings.social_pinterest }}" class="footer__social-link" aria-label="Pinterest" target="_blank" rel="noopener">
                <svg viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 0C5.373 0 0 5.373 0 12c0 5.084 3.163 9.426 7.627 11.174-.105-.949-.2-2.405.042-3.441.218-.937 1.407-5.965 1.407-5.965s-.359-.719-.359-1.782c0-1.668.967-2.914 2.171-2.914 1.023 0 1.518.769 1.518 1.69 0 1.029-.655 2.568-.994 3.995-.283 1.194.599 2.169 1.777 2.169 2.133 0 3.772-2.249 3.772-5.495 0-2.873-2.064-4.882-5.012-4.882-3.65 0-5.789 2.738-5.789 5.57 0 1.103.425 2.286.956 2.928.105.128.12.24.089.372-.098.403-.316 1.29-.359 1.472-.057.242-.19.294-.437.178-1.628-.758-2.646-3.135-2.646-5.046 0-4.114 2.993-7.889 8.632-7.889 4.533 0 8.055 3.232 8.055 7.558 0 4.508-2.84 8.138-6.784 8.138-1.326 0-2.572-.69-3-1.503l-.814 3.097c-.294 1.132-1.088 2.548-1.625 3.418A12 12 0 1 0 12 0z"/>
                </svg>
              </a>
            {% endif %}
          </div>
        {% endif %}
      </div>

      <!-- Menu 1 -->
      {% if section.settings.menu_1 != blank %}
        <div class="footer__menu">
          <h3 class="footer__menu-title">{{ linklists[section.settings.menu_1].title }}</h3>
          <ul class="footer__menu-list">
            {% for link in linklists[section.settings.menu_1].links %}
              <li class="footer__menu-item">
                <a href="{{ link.url }}">{{ link.title }}</a>
              </li>
            {% endfor %}
          </ul>
        </div>
      {% endif %}

      <!-- Menu 2 -->
      {% if section.settings.menu_2 != blank %}
        <div class="footer__menu">
          <h3 class="footer__menu-title">{{ linklists[section.settings.menu_2].title }}</h3>
          <ul class="footer__menu-list">
            {% for link in linklists[section.settings.menu_2].links %}
              <li class="footer__menu-item">
                <a href="{{ link.url }}">{{ link.title }}</a>
              </li>
            {% endfor %}
          </ul>
        </div>
      {% endif %}

      <!-- Menu 3 -->
      {% if section.settings.menu_3 != blank %}
        <div class="footer__menu">
          <h3 class="footer__menu-title">{{ linklists[section.settings.menu_3].title }}</h3>
          <ul class="footer__menu-list">
            {% for link in linklists[section.settings.menu_3].links %}
              <li class="footer__menu-item">
                <a href="{{ link.url }}">{{ link.title }}</a>
              </li>
            {% endfor %}
          </ul>
        </div>
      {% endif %}
    </div>

    <!-- Bottom Bar -->
    <div class="footer__bottom">
      <p class="footer__copyright">
        &copy; {{ 'now' | date: "%Y" }} {{ shop.name }}. {{ section.settings.copyright_text | default: "All rights reserved." }}
      </p>

      <div class="footer__payments">
        <div class="footer__payment-icon">
          <svg viewBox="0 0 38 24" fill="currentColor">
            <path d="M35 0H3C1.3 0 0 1.3 0 3v18c0 1.7 1.4 3 3 3h32c1.7 0 3-1.3 3-3V3c0-1.7-1.4-3-3-3z"/>
          </svg>
        </div>
        <div class="footer__payment-icon">
          <svg viewBox="0 0 38 24" fill="currentColor">
            <circle cx="12" cy="12" r="10"/>
            <circle cx="26" cy="12" r="10"/>
          </svg>
        </div>
        <div class="footer__payment-icon">
          <svg viewBox="0 0 38 24" fill="currentColor">
            <path d="M35 0H3C1.3 0 0 1.3 0 3v18c0 1.7 1.4 3 3 3h32c1.7 0 3-1.3 3-3V3c0-1.7-1.4-3-3-3z"/>
          </svg>
        </div>
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "tag": "footer",
  "class": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "footer_logo",
      "label": "Footer Logo"
    },
    {
      "type": "textarea",
      "id": "footer_description",
      "label": "Description",
      "default": "Premium skincare products crafted with natural ingredients for radiant, healthy-looking skin."
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "label": "Show social media icons",
      "default": true
    },
    {
      "type": "text",
      "id": "social_facebook",
      "label": "Facebook URL"
    },
    {
      "type": "text",
      "id": "social_instagram",
      "label": "Instagram URL"
    },
    {
      "type": "text",
      "id": "social_twitter",
      "label": "Twitter URL"
    },
    {
      "type": "text",
      "id": "social_pinterest",
      "label": "Pinterest URL"
    },
    {
      "type": "link_list",
      "id": "menu_1",
      "label": "Menu 1"
    },
    {
      "type": "link_list",
      "id": "menu_2",
      "label": "Menu 2"
    },
    {
      "type": "link_list",
      "id": "menu_3",
      "label": "Menu 3"
    },
    {
      "type": "text",
      "id": "copyright_text",
      "label": "Copyright Text",
      "default": "All rights reserved."
    }
  ],
  "default": {
    "settings": {
      "show_social": true
    }
  }
}
{% endschema %}
