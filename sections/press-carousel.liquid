{%- style -%}
  .press-carousel {
    padding: 80px 40px;
    background-color: #F9FAF8;
  }

  .press-carousel__heading {
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: #5C6E61;
    text-align: center;
    margin-bottom: 40px;
  }

  .press-carousel__container {
    position: relative;
    max-width: 1200px;
    margin: 0 auto;
    overflow: hidden;
  }

  .press-carousel__track {
    display: flex;
    transition: transform 0.5s ease;
  }

  .press-carousel__slide {
    min-width: 100%;
    padding: 20px;
  }

  .press-carousel__quote {
    font-family: 'Cormorant Garamond', serif;
    font-size: 24px;
    font-style: italic;
    color: #2C302E;
    line-height: 1.6;
    margin-bottom: 20px;
  }

  .press-carousel__link {
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: #5C6E61;
    text-decoration: none;
  }

  .press-carousel__link:hover {
    text-decoration: underline;
  }

  .press-carousel__nav {
    display: flex;
    justify-content: center;
    gap: 20px;
    margin-top: 30px;
  }

  .press-carousel__button {
    background: none;
    border: 1px solid #5C6E61;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color 0.3s ease;
  }

  .press-carousel__button:hover {
    background-color: #5C6E61;
  }

  .press-carousel__button:hover svg {
    stroke: #FFFFFF;
  }

  .press-carousel__button svg {
    width: 20px;
    height: 20px;
    stroke: #5C6E61;
  }

  @media (max-width: 768px) {
    .press-carousel {
      padding: 60px 20px;
    }

    .press-carousel__quote {
      font-size: 20px;
    }
  }
{%- endstyle -%}

<section class="press-carousel" data-section-id="{{ section.id }}">
  <h2 class="press-carousel__heading">{{ section.settings.heading | default: 'IN THE PRESS' }}</h2>

  <div class="press-carousel__container">
    <div class="press-carousel__track" id="pressTrack">
      {%- for block in section.blocks -%}
        <div class="press-carousel__slide" {{ block.shopify_attributes }}>
          {%- if block.settings.quote != blank -%}
            <p class="press-carousel__quote">{{ block.settings.quote }}</p>
          {%- endif -%}
          {%- if block.settings.link_text != blank and block.settings.link_url != blank -%}
            <a href="{{ block.settings.link_url }}" class="press-carousel__link">
              {{ block.settings.link_text }}
            </a>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>

  <div class="press-carousel__nav">
    <button class="press-carousel__button" onclick="moveSlide(-1)" aria-label="Previous">
      <svg viewBox="0 0 24 24" fill="none" stroke-width="2">
        <path d="M15 18l-6-6 6-6"/>
      </svg>
    </button>
    <button class="press-carousel__button" onclick="moveSlide(1)" aria-label="Next">
      <svg viewBox="0 0 24 24" fill="none" stroke-width="2">
        <path d="M9 18l6-6-6-6"/>
      </svg>
    </button>
  </div>
</section>

<script>
  let currentSlide = 0;
  const track = document.getElementById('pressTrack');
  const slides = track ? track.children : [];
  const totalSlides = slides.length;

  function moveSlide(direction) {
    if (!track || totalSlides === 0) return;
    currentSlide = (currentSlide + direction + totalSlides) % totalSlides;
    track.style.transform = `translateX(-${currentSlide * 100}%)`;
  }
</script>

{% schema %}
{
  "name": "Press Carousel",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "IN THE PRESS"
    }
  ],
  "blocks": [
    {
      "type": "quote",
      "name": "Quote",
      "settings": [
        {
          "type": "text",
          "id": "quote",
          "label": "Quote"
        },
        {
          "type": "text",
          "id": "link_text",
          "label": "Link Text",
          "default": "READ FULL ARTICLE"
        },
        {
          "type": "url",
          "id": "link_url",
          "label": "Link URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Press Carousel",
      "blocks": [
        { "type": "quote" },
        { "type": "quote" },
        { "type": "quote" },
        { "type": "quote" },
        { "type": "quote" }
      ]
    }
  ]
}
{% endschema %}
