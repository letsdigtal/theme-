{% comment %}
  Testimonial Section - LivSo Style
  Quote with person image
{% endcomment %}

<section class="testimonial" id="testimonial">
  {% if section.settings.person_image != blank %}
    <img class="person parallax" data-parallax-duration="600%" src="{{ section.settings.person_image | image_url: width: 800 }}" data-rjs="{{ section.settings.person_image | image_url: width: 1600 }}">
  {% endif %}
  
  <h3>&ldquo;{{ section.settings.quote }}&rdquo;</h3>
  <p>&mdash; {{ section.settings.author }}</p>
  
  <div class="wave-wrap">
    <svg viewBox="0 0 1200 120" preserveAspectRatio="none">
      <path d="M0,0V46.29c47.79,22.2,103.59,32.17,158,28,70.36-5.37,136.33-33.31,206.8-37.5C438.64,32.43,512.34,53.67,583,72.05c69.27,18,138.3,24.88,209.4,13.08,36.15-6,69.85-17.84,104.45-29.34C989.49,25,1113-14.29,1200,52.47V0Z" opacity=".23"/>
      <path d="M0,0V15.81C13,36.92,27.64,56.86,47.69,72.05,99.41,111.27,165,111,224.58,91.58c31.15-10.15,60.09-26.07,89.67-39.8,40.92-19,84.73-46,130.83-49.67,36.26-2.85,70.9,9.42,98.6,31.56,31.77,25.39,62.32,62,103.63,73,40.44,10.79,81.35-6.69,119.13-24.28s75.16-39,116.92-43.05c59.73-5.85,113.28,22.88,168.9,38.84,30.2,8.66,59,6.17,87.09-7.5,22.43-10.89,48-26.93,60.65-49.24V0Z" opacity=".5"/>
      <path d="M0,0V5.63C149.93,59,314.09,66.42,475.08,42.83c43-6.34,81.54-25.96,127.67-29.58,38.89-3.05,73.05,15.71,104.32,37,27.59,18.78,63.15,31.33,96.78,28.54,34.74-2.88,62.33-27.05,91.65-39.67,33.12-14.32,70.18-19.84,104.92-11.16,34.72,8.67,60.73,35.17,85.82,56.63C1146.48,98.55,1172,111.63,1200,96.81V0Z"/>
    </svg>
  </div>
</section>

{% schema %}
{
  "name": "Testimonial",
  "settings": [
    {
      "type": "image_picker",
      "id": "person_image",
      "label": "Person Image"
    },
    {
      "type": "text",
      "id": "quote",
      "label": "Quote",
      "default": "I feel like LivSo helped me love my hair again."
    },
    {
      "type": "text",
      "id": "author",
      "label": "Author",
      "default": "Elizabeth Blount"
    }
  ]
}
{% endschema %}
