{% comment %}
  Newsletter Section - LivSo Style
  Email signup form
{% endcomment %}

<div class="mailing-list">
  <h2>{{ section.settings.title }}</h2>
  
  <div id="mc_embed_signup" class="form-wrapper">
    <form action="{{ section.settings.mailchimp_url }}" method="POST" id="mc-embedded-subscribe-form" name="mc-embedded-subscribe-form" class="validate input-group" target="_blank" novalidate>
      <input type="email" name="EMAIL" id="mce-EMAIL" value="" placeholder="{{ section.settings.placeholder }}">
      <label for="mce-EMAIL">{{ section.settings.label }}</label>
      
      <div style="position: absolute; left: -5000px;" aria-hidden="true">
        <input type="text" name="{{ section.settings.honeypot_name }}" tabindex="-1" value="">
      </div>
      
      <button type="submit" class="submit" id="mce-embedded-subscribe" name="subscribe" value="Subscribe">
        {{ section.settings.button_text }}
      </button>
    </form>
  </div>
</div>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Stay up on our<br> latest<br> healthy hair tips,<br> products & more"
    },
    {
      "type": "url",
      "id": "mailchimp_url",
      "label": "Mailchimp Form URL"
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Input Placeholder"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Input Label",
      "default": "Email"
    },
    {
      "type": "text",
      "id": "honeypot_name",
      "label": "Honeypot Field Name",
      "default": "b_944e50126e4eb2fdd37b74b1a_f000b0f908"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Sign Up"
    }
  ]
}
{% endschema %}
