{%- style -%}
  .newsletter {
    padding: 80px 40px;
    background-color: #E2ECE2;
    text-align: center;
  }

  .newsletter__title {
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: #2C302E;
    margin-bottom: 32px;
    max-width: 700px;
    margin-left: auto;
    margin-right: auto;
    line-height: 1.6;
  }

  .newsletter__form {
    display: flex;
    max-width: 500px;
    margin: 0 auto;
    gap: 0;
  }

  .newsletter__input {
    flex: 1;
    padding: 16px 20px;
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    border: none;
    outline: none;
    background-color: #FFFFFF;
    border-radius: 4px 0 0 4px;
  }

  .newsletter__button {
    padding: 16px 32px;
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: #FFFFFF;
    background-color: #5C6E61;
    border: none;
    border-radius: 0 4px 4px 0;
    cursor: pointer;
    transition: background-color 0.3s ease;
  }

  .newsletter__button:hover {
    background-color: #4a5a50;
  }

  @media (max-width: 768px) {
    .newsletter {
      padding: 60px 20px;
    }

    .newsletter__form {
      flex-direction: column;
      gap: 12px;
    }

    .newsletter__input {
      border-radius: 4px;
    }

    .newsletter__button {
      border-radius: 4px;
    }
  }
{%- endstyle -%}

<section class="newsletter" data-section-id="{{ section.id }}">
  {%- if section.settings.title != blank -%}
    <h2 class="newsletter__title">{{ section.settings.title }}</h2>
  {%- endif -%}

  {%- form 'customer' -%}
    <input type="hidden" name="contact[tags]" value="newsletter">
    <div class="newsletter__form">
      <input 
        type="email" 
        name="contact[email]" 
        class="newsletter__input" 
        placeholder="Enter your email"
        required
      >
      <button type="submit" class="newsletter__button">
        {{ section.settings.button_text | default: 'SIGN UP' }}
      </button>
    </div>
  {%- endform -%}
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "STAY UP ON OUR LATEST HEALTHY HAIR TIPS, PRODUCTS & MORE"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "SIGN UP"
    }
  ],
  "presets": [
    {
      "name": "Newsletter"
    }
  ]
}
{% endschema %}
