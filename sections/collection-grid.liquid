{%- style -%}
  .collection-grid {
    padding: var(--spacing-xl) 2rem;
    background: #faf9f7;
  }

  .collection-grid__container {
    max-width: 1400px;
    margin: 0 auto;
  }

  .collection-grid__header {
    text-align: center;
    margin-bottom: 4rem;
  }

  .collection-grid__subtitle {
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 3px;
    color: var(--color-primary);
    text-transform: uppercase;
    margin-bottom: 1rem;
  }

  .collection-grid__title {
    font-family: var(--font-heading);
    font-size: 2.5rem;
    font-weight: 400;
    letter-spacing: 1px;
    color: var(--color-text);
    margin-bottom: 1rem;
  }

  .collection-grid__description {
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.7;
    color: #666;
    max-width: 600px;
    margin: 0 auto;
  }

  .collection-grid__products {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
  }

  .collection-grid__product {
    position: relative;
    group: product-card;
  }

  .collection-grid__product-image-wrapper {
    position: relative;
    width: 100%;
    padding-top: 125%;
    overflow: hidden;
    background: #f0f0f0;
    border-radius: var(--border-radius-md);
    margin-bottom: 1rem;
  }

  .collection-grid__product-image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  .collection-grid__product-image--secondary {
    opacity: 0;
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 0.4s ease;
  }

  .collection-grid__product:hover .collection-grid__product-image--secondary {
    opacity: 1;
  }

  .collection-grid__product:hover .collection-grid__product-image {
    transform: scale(1.05);
  }

  .collection-grid__product-badges {
    position: absolute;
    top: 1rem;
    left: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    z-index: 2;
  }

  .collection-grid__badge {
    background: #ffffff;
    color: var(--color-text);
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 1px;
    text-transform: uppercase;
    padding: 0.5rem 0.75rem;
    border-radius: var(--border-radius-sm);
  }

  .collection-grid__badge--sale {
    background: var(--color-primary);
    color: #ffffff;
  }

  .collection-grid__quick-add {
    position: absolute;
    bottom: 1rem;
    left: 1rem;
    right: 1rem;
    background: #ffffff;
    color: var(--color-text);
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 1px;
    text-transform: uppercase;
    text-align: center;
    padding: 1rem;
    border: none;
    cursor: pointer;
    transform: translateY(100%);
    opacity: 0;
    transition: all 0.3s ease;
    z-index: 2;
  }

  .collection-grid__product:hover .collection-grid__quick-add {
    transform: translateY(0);
    opacity: 1;
  }

  .collection-grid__quick-add:hover {
    background: var(--color-primary);
    color: #ffffff;
  }

  .collection-grid__product-info {
    text-align: center;
  }

  .collection-grid__product-vendor {
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 1px;
    color: #888;
    text-transform: uppercase;
    margin-bottom: 0.5rem;
  }

  .collection-grid__product-title {
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 500;
    color: var(--color-text);
    margin-bottom: 0.5rem;
    line-height: 1.4;
  }

  .collection-grid__product-title a {
    color: inherit;
    text-decoration: none;
    transition: opacity 0.3s ease;
  }

  .collection-grid__product-title a:hover {
    opacity: 0.7;
  }

  .collection-grid__product-price {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    color: var(--color-text);
    margin-bottom: 0.5rem;
  }

  .collection-grid__product-price--compare {
    text-decoration: line-through;
    color: #999;
    margin-right: 0.5rem;
  }

  .collection-grid__product-price--sale {
    color: var(--color-primary);
    font-weight: 600;
  }

  .collection-grid__product-rating {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.25rem;
    margin-top: 0.5rem;
  }

  .collection-grid__star {
    width: 16px;
    height: 16px;
    color: #d4a574;
  }

  .collection-grid__star--empty {
    color: #e0e0e0;
  }

  @media screen and (max-width: 1200px) {
    .collection-grid__products {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media screen and (max-width: 1024px) {
    .collection-grid__products {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.5rem;
    }
  }

  @media screen and (max-width: 768px) {
    .collection-grid {
      padding: var(--spacing-lg) 1.5rem;
    }

    .collection-grid__title {
      font-size: 2rem;
    }

    .collection-grid__products {
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem;
    }

    .collection-grid__quick-add {
      font-size: 0.75rem;
      padding: 0.75rem;
    }
  }
{%- endstyle -%}

<section class="collection-grid" data-section-id="{{ section.id }}">
  <div class="collection-grid__container">
    {% if section.settings.section_subtitle != blank or section.settings.section_title != blank %}
      <div class="collection-grid__header">
        {% if section.settings.section_subtitle != blank %}
          <p class="collection-grid__subtitle">{{ section.settings.section_subtitle }}</p>
        {% endif %}
        
        {% if section.settings.section_title != blank %}
          <h2 class="collection-grid__title">{{ section.settings.section_title }}</h2>
        {% endif %}
        
        {% if section.settings.section_description != blank %}
          <p class="collection-grid__description">{{ section.settings.section_description }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div class="collection-grid__products">
      {% assign collection = collections[section.settings.collection] %}
      
      {% for product in collection.products limit: section.settings.products_to_show %}
        <div class="collection-grid__product" data-scroll-animate>
          <div class="collection-grid__product-image-wrapper">
            {% if product.featured_media %}
              <img 
                src="{{ product.featured_media | image_url: width: 600 }}"
                alt="{{ product.title | escape }}"
                class="collection-grid__product-image"
                loading="lazy"
                width="600"
                height="750"
              >
              
              {% if product.media[1] %}
                <img 
                  src="{{ product.media[1] | image_url: width: 600 }}"
                  alt="{{ product.title | escape }}"
                  class="collection-grid__product-image--secondary"
                  loading="lazy"
                  width="600"
                  height="750"
                >
              {% endif %}
            {% else %}
              {{ 'product-1' | placeholder_svg_tag: 'collection-grid__product-image' }}
            {% endif %}

            {% if product.compare_at_price > product.price %}
              <div class="collection-grid__product-badges">
                <span class="collection-grid__badge collection-grid__badge--sale">Sale</span>
              </div>
            {% endif %}

            {% if product.available %}
              <button class="collection-grid__quick-add" 
                      data-product-id="{{ product.id }}"
                      aria-label="Quick add {{ product.title }} to cart">
                Quick Add
              </button>
            {% else %}
              <div class="collection-grid__product-badges">
                <span class="collection-grid__badge">Sold Out</span>
              </div>
            {% endif %}
          </div>

          <div class="collection-grid__product-info">
            {% if product.vendor != blank %}
              <p class="collection-grid__product-vendor">{{ product.vendor }}</p>
            {% endif %}
            
            <h3 class="collection-grid__product-title">
              <a href="{{ product.url }}">{{ product.title }}</a>
            </h3>
            
            <div class="collection-grid__product-price">
              {% if product.compare_at_price > product.price %}
                <span class="collection-grid__product-price--compare">{{ product.compare_at_price | money }}</span>
              {% endif %}
              <span class="{% if product.compare_at_price > product.price %}collection-grid__product-price--sale{% endif %}">
                {{ product.price | money }}
              </span>
            </div>

            {% if product.metafields.reviews.rating.value != blank %}
              <div class="collection-grid__product-rating">
                {% assign rating = product.metafields.reviews.rating.value | round: 0 %}
                {% for i in (1..5) %}
                  <svg class="collection-grid__star {% if i > rating %}collection-grid__star--empty{% endif %}" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                  </svg>
                {% endfor %}
              </div>
            {% endif %}
          </div>
        </div>
      {% else %}
        {% for i in (1..4) %}
          <div class="collection-grid__product" data-scroll-animate>
            <div class="collection-grid__product-image-wrapper">
              {{ 'product-1' | placeholder_svg_tag: 'collection-grid__product-image' }}
            </div>
            <div class="collection-grid__product-info">
              <h3 class="collection-grid__product-title">Example Product {{ i }}</h3>
              <div class="collection-grid__product-price">$49.00</div>
            </div>
          </div>
        {% endfor %}
      {% endfor %}
    </div>
  </div>
</section>

<script>
  (function() {
    const observerOptions = {
      root: null,
      rootMargin: '0px',
      threshold: 0.1
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry, index) => {
        if (entry.isIntersecting) {
          setTimeout(() => {
            entry.target.style.opacity = '1';
            entry.target.style.transform = 'translateY(0)';
          }, index * 100);
          observer.unobserve(entry.target);
        }
      });
    }, observerOptions);

    document.querySelectorAll('[data-scroll-animate]').forEach(el => {
      el.style.opacity = '0';
      el.style.transform = 'translateY(30px)';
      el.style.transition = 'all 0.6s ease';
      observer.observe(el);
    });

    // Quick add functionality
    document.querySelectorAll('.collection-grid__quick-add').forEach(btn => {
      btn.addEventListener('click', async function() {
        const productId = this.dataset.productId;
        const originalText = this.textContent;
        
        this.textContent = 'Adding...';
        this.disabled = true;

        try {
          const response = await fetch(window.routes.cart_add_url, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json'
            },
            body: JSON.stringify({
              items: [{
                id: productId,
                quantity: 1
              }]
            })
          });

          if (response.ok) {
            this.textContent = 'Added!';
            setTimeout(() => {
              this.textContent = originalText;
              this.disabled = false;
            }, 1500);
            
            // Update cart count
            const cartCountEl = document.querySelector('.header__cart-count');
            if (cartCountEl) {
              const currentCount = parseInt(cartCountEl.textContent) || 0;
              cartCountEl.textContent = currentCount + 1;
            }
          }
        } catch (error) {
          console.error('Error adding to cart:', error);
          this.textContent = 'Try Again';
          this.disabled = false;
        }
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Collection Grid",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "section_subtitle",
      "label": "Subtitle",
      "default": "BESTSELLERS"
    },
    {
      "type": "text",
      "id": "section_title",
      "label": "Title",
      "default": "Our Favorite Products"
    },
    {
      "type": "textarea",
      "id": "section_description",
      "label": "Description",
      "default": "Discover our most loved skincare essentials, carefully formulated for radiant, healthy-looking skin."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 4,
      "max": 12,
      "step": 1,
      "default": 8
    }
  ],
  "presets": [
    {
      "name": "Collection Grid"
    }
  ]
}
{% endschema %}
