{% comment %}
  Hero Banner Section - LivSo Style
  Full-width hero with product lifestyle background
{% endcomment %}

<section class="hero" id="hero">
  {% if section.settings.hero_image != blank %}
    <img src="{{ section.settings.hero_image | image_url: width: 2000 }}" alt="{{ section.settings.heading }}" data-rjs="{{ section.settings.hero_image | image_url: width: 4000 }}">
  {% else %}
    <img src="//livso.com/cdn/shop/t/1/assets/hero.png" alt="{{ section.settings.heading }}" data-rjs="//livso.com/cdn/shopifycloud/storefront/assets/no-image-2048-a2addb12_grande.gif">
  {% endif %}
  
  <h1>
    <span>{{ section.settings.heading_part1 }}</span><br>
    <span>{{ section.settings.heading_part2 }}</span>
  </h1>
  
  <p>{{ section.settings.subtext }}</p>
  
  {% if section.settings.button_label != blank and section.settings.button_link != blank %}
    <a href="{{ section.settings.button_link }}" class="cta">
      {{ section.settings.button_label }}
      <svg xmlns="http://www.w3.org/2000/svg" fill="#FFF" viewBox="0 0 29.36 11.73">
        <rect y="5.36" width="29" height="1" fill="#FFF"/>
        <polyline points="28.66 5.36 23 11.02 23.71 11.73 29.36 6.07 29.36 5.66 23.71 0 23 0.71 28.66 6.36"/>
      </svg>
    </a>
  {% endif %}
</section>

{% schema %}
{
  "name": "Hero Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero Image"
    },
    {
      "type": "text",
      "id": "heading_part1",
      "label": "Heading Part 1",
      "default": "Expertly Made,"
    },
    {
      "type": "text",
      "id": "heading_part2",
      "label": "Heading Part 2",
      "default": "Perfectly You"
    },
    {
      "type": "richtext",
      "id": "subtext",
      "label": "Subtext",
      "default": "<p>Handpicked ingredients by a Board-Certified Dermatologist alleviate scalp dryness and itching. Our formulas nourish and moisturize your naturally textured kinky, curly, or wavy hair from the root to the tip.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ]
}
{% endschema %}
