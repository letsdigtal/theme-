{%- style -%}
  .hero-banner {
    position: relative;
    background-color: #E2ECE2;
    min-height: 90vh;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .hero-banner__background {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.3;
  }

  .hero-banner__content {
    position: relative;
    z-index: 2;
    max-width: 600px;
    padding: 80px 40px;
    margin-left: 10%;
  }

  .hero-banner__title {
    font-family: 'Cormorant Garamond', serif;
    font-size: 64px;
    font-weight: 600;
    color: #2C302E;
    line-height: 1.1;
    margin-bottom: 24px;
  }

  .hero-banner__text {
    font-family: 'Inter', sans-serif;
    font-size: 16px;
    line-height: 1.8;
    color: #2C302E;
    margin-bottom: 40px;
  }

  .hero-banner__button {
    display: inline-block;
    background-color: #5C6E61;
    color: #FFFFFF;
    padding: 18px 40px;
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 1px;
    text-decoration: none;
    border-radius: 4px;
    transition: background-color 0.3s ease, transform 0.3s ease;
  }

  .hero-banner__button:hover {
    background-color: #4a5a50;
    transform: translateY(-2px);
  }

  @media (max-width: 768px) {
    .hero-banner__content {
      margin-left: 0;
      padding: 60px 20px;
      text-align: center;
    }

    .hero-banner__title {
      font-size: 42px;
    }

    .hero-banner__text {
      font-size: 15px;
    }
  }
{%- endstyle -%}

<section class="hero-banner" data-section-id="{{ section.id }}">
  {%- if section.settings.background_image != blank -%}
    <img 
      src="{{ section.settings.background_image | image_url: width: 2000 }}" 
      alt="{{ section.settings.title | escape }}"
      class="hero-banner__background"
      loading="eager"
    >
  {%- endif -%}

  <div class="hero-banner__content">
    {%- if section.settings.title != blank -%}
      <h1 class="hero-banner__title">{{ section.settings.title }}</h1>
    {%- endif -%}

    {%- if section.settings.text != blank -%}
      <p class="hero-banner__text">{{ section.settings.text }}</p>
    {%- endif -%}

    {%- if section.settings.button_text != blank and section.settings.button_link != blank -%}
      <a href="{{ section.settings.button_link }}" class="hero-banner__button">
        {{ section.settings.button_text }}
      </a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Hero Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Expertly Made, Perfectly You"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Handpicked ingredients by a Board-Certified Dermatologist alleviate scalp dryness and itching. Our formulas nourish and moisturize your naturally textured kinky, curly, or wavy hair from the root to the tip.</p>"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Hero Banner"
    }
  ]
}
{% endschema %}
