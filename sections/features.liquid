{%- style -%}
  .features {
    padding: var(--spacing-xl) 2rem;
    background: #ffffff;
  }

  .features__container {
    max-width: 1400px;
    margin: 0 auto;
  }

  .features__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 3rem;
  }

  .features__item {
    text-align: center;
    padding: 2rem;
    opacity: 0;
    transform: translateY(30px);
    transition: all 0.6s ease;
  }

  .features__item.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .features__icon {
    width: 80px;
    height: 80px;
    margin: 0 auto 1.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-primary);
  }

  .features__icon svg {
    width: 100%;
    height: 100%;
  }

  .features__title {
    font-family: var(--font-heading);
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: 1px;
    color: var(--color-text);
    margin-bottom: 0.75rem;
    text-transform: uppercase;
  }

  .features__text {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    line-height: 1.7;
    color: #666;
  }

  @media screen and (max-width: 1024px) {
    .features__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 2rem;
    }
  }

  @media screen and (max-width: 768px) {
    .features {
      padding: var(--spacing-lg) 1.5rem;
    }

    .features__grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .features__item {
      padding: 1.5rem;
    }
  }
{%- endstyle -%}

<section class="features" data-section-id="{{ section.id }}">
  <div class="features__container">
    <div class="features__grid">
      {% for block in section.blocks %}
        <div class="features__item" {{ block.shopify_attributes }} data-scroll-animate>
          {% if block.settings.icon_svg != blank %}
            <div class="features__icon">
              {{ block.settings.icon_svg }}
            </div>
          {% elsif block.settings.icon_image != blank %}
            <div class="features__icon">
              <img src="{{ block.settings.icon_image | image_url: width: 160 }}" alt="" width="80" height="80">
            </div>
          {% else %}
            <div class="features__icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
              </svg>
            </div>
          {% endif %}
          
          {% if block.settings.title != blank %}
            <h3 class="features__title">{{ block.settings.title }}</h3>
          {% endif %}
          
          {% if block.settings.text != blank %}
            <p class="features__text">{{ block.settings.text }}</p>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<script>
  (function() {
    const observerOptions = {
      root: null,
      rootMargin: '0px',
      threshold: 0.1
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry, index) => {
        if (entry.isIntersecting) {
          setTimeout(() => {
            entry.target.classList.add('is-visible');
          }, index * 100);
          observer.unobserve(entry.target);
        }
      });
    }, observerOptions);

    document.querySelectorAll('[data-scroll-animate]').forEach(el => {
      observer.observe(el);
    });
  })();
</script>

{% schema %}
{
  "name": "Features",
  "tag": "section",
  "class": "section",
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "html",
          "id": "icon_svg",
          "label": "Icon SVG Code"
        },
        {
          "type": "image_picker",
          "id": "icon_image",
          "label": "Icon Image (alternative)"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Natural Ingredients"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Crafted with pure, organic ingredients sourced from nature."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Features",
      "blocks": [
        {
          "type": "feature"
        },
        {
          "type": "feature"
        },
        {
          "type": "feature"
        },
        {
          "type": "feature"
        }
      ]
    }
  ]
}
{% endschema %}
